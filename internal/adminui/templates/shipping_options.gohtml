{{- /*
shipping_options.gohtml lists the fulfillment module's shipping options (ADR
0333).

An option is how a parcel is sent: its provider carries it, its profile says
which goods it carries, and its region says where it is offered, every
region when it names none. A flat option charges the fee it carries; a
calculated one asks its provider for the fee. An option the storefront does
not offer is for the panel and the telephone order alone. The rows come
newest first, through the module's shipping_option entity.

Each row's form renames its option, sets a flat option's fee, says whether
the storefront offers it and how many business days its delivery takes; it
carries them as the row was drawn, and the module refuses when another
operator revised the option first. The days are the carrier's working days,
the least and the most, both or neither (ADR 0421). The provider,
the profile, the price type and the region are the option's identity and
are not revised here.

An operator who may write the options writes one here, on a provider this
installation registers and one of the newest shipping profiles (ADR 0334).
An option in a region charges in that region's currency; one in every
region charges in the currency typed.
*/ -}}
{{ define "body" }}
<h1>{{ .Title }}</h1>

{{ with .Refused }}<p role="alert">{{ . }}</p>{{ end }}
{{ with .Created }}<p role="status">Shipping option {{ . }} was written.</p>{{ end }}

{{ with .Choices }}
<details{{ if $.Typed }} open{{ end }}>
  <summary>New shipping option</summary>
  {{ if .Profiles }}
  <form method="post" action="{{ $.Path }}">
    <input name="name" value="{{ $.Typed.Get "name" }}" placeholder="name, e.g. Courier" aria-label="name" required>
    <select name="provider_id" aria-label="provider">
      {{ range .Providers }}<option value="{{ . }}"{{ if eq ($.Typed.Get "provider_id") . }} selected{{ end }}>{{ . }}</option>{{ end }}
    </select>
    <select name="shipping_profile_id" aria-label="profile">
      {{ range .Profiles }}<option value="{{ .ID }}"{{ if eq ($.Typed.Get "shipping_profile_id") .ID }} selected{{ end }}>{{ .Name }}</option>{{ end }}
    </select>{{ if .ProfilesMore }} <span class="muted">the newest profiles</span>{{ end }}
    <select name="price_type" aria-label="price type">
      <option value="flat"{{ if eq ($.Typed.Get "price_type") "flat" }} selected{{ end }}>a flat fee</option>
      <option value="calculated"{{ if eq ($.Typed.Get "price_type") "calculated" }} selected{{ end }}>the provider's rate</option>
    </select>
    <input name="amount" value="{{ $.Typed.Get "amount" }}" placeholder="fee, for a flat fee" aria-label="fee" inputmode="decimal">
    <select name="region_id" aria-label="region">
      <option value="">every region</option>
      {{ range $.Regions }}<option value="{{ .ID }}"{{ if eq ($.Typed.Get "region_id") .ID }} selected{{ end }}>{{ .Name }} ({{ .Currency }})</option>{{ end }}
    </select>
    <input name="currency_code" value="{{ $.Typed.Get "currency_code" }}" placeholder="currency, for every region" aria-label="currency" maxlength="3">
    <input name="delivery_min_days" value="{{ $.Typed.Get "delivery_min_days" }}" placeholder="least business days" aria-label="least business days" inputmode="numeric">
    <input name="delivery_max_days" value="{{ $.Typed.Get "delivery_max_days" }}" placeholder="most business days" aria-label="most business days" inputmode="numeric">
    <label><input type="checkbox" name="is_return" value="1"{{ if $.Typed.Get "is_return" }} checked{{ end }}> for returns</label>
    <label><input type="checkbox" name="admin_only" value="1"{{ if $.Typed.Get "admin_only" }} checked{{ end }}> panel only</label>
    <button type="submit">Write the shipping option</button>
  </form>
  {{ else }}
  <p class="muted">No shipping profile has been written; an option is written on one.</p>
  {{ end }}
</details>
{{ end }}

{{ if .Options }}
<div class="scroll">
<table>
  <thead>
    <tr><th>Option</th><th>Provider</th><th>Profile</th><th>Region</th><th class="num">Fee</th><th>Delivery</th><th>Storefront</th>{{ if .CanRevise }}<th></th>{{ end }}</tr>
  </thead>
  <tbody>
  {{ range $row := .Options }}
    <tr>
      <td>{{ .Name }} <span class="muted">{{ .ID }}</span>{{ if .IsReturn }} <span class="pill">return</span>{{ end }}</td>
      <td>{{ .Provider }}</td>
      <td><span class="muted">{{ .Profile }}</span></td>
      <td>{{ with .Region }}{{ . }}{{ else }}<span class="muted">every region</span>{{ end }}</td>
      <td class="num">{{ with .Fee }}{{ . }}{{ else }}<span class="muted">from the provider</span>{{ end }}</td>
      <td>{{ with .Days }}{{ . }}{{ else }}<span class="muted">not said</span>{{ end }}</td>
      <td>{{ if .AdminOnly }}<span class="muted">panel only</span>{{ else }}offered{{ end }}</td>
      {{ if $.CanRevise }}
      <td>
        <details{{ if $row.Refused }} open{{ end }}>
          <summary>Revise</summary>
          <form method="post" action="{{ $.Path }}/{{ $row.ID }}?page={{ $.Page }}">
            <input type="hidden" name="read_name" value="{{ $row.Name }}">
            <input type="hidden" name="read_amount" value="{{ $row.Amount }}">
            <input type="hidden" name="read_admin_only" value="{{ $row.AdminOnly }}">
            <input type="hidden" name="read_delivery_min_days" value="{{ $row.MinDays }}">
            <input type="hidden" name="read_delivery_max_days" value="{{ $row.MaxDays }}">
            <input type="hidden" name="price_type" value="{{ $row.PriceType }}">
            <input type="hidden" name="currency_code" value="{{ $row.Currency }}">
            <input name="name" value="{{ $row.FormName }}" aria-label="name" required>
            {{ if eq $row.PriceType $.FlatPriceType }}<input name="amount" value="{{ $row.FormAmount }}" aria-label="fee" placeholder="{{ $row.Currency }}" inputmode="decimal" required>{{ end }}
            <input name="delivery_min_days" value="{{ $row.FormMinDays }}" aria-label="least business days" placeholder="least days" inputmode="numeric">
            <input name="delivery_max_days" value="{{ $row.FormMaxDays }}" aria-label="most business days" placeholder="most days" inputmode="numeric">
            <label><input type="checkbox" name="admin_only" value="1"{{ if $row.FormAdminOnly }} checked{{ end }}> panel only</label>
            <button type="submit">Write</button>
          </form>
        </details>
      </td>
      {{ end }}
    </tr>
  {{ end }}
  </tbody>
</table>
</div>
{{ else }}
<p class="muted">No shipping option has been written.</p>
{{ end }}

<nav>
  {{ if .HasPrev }}<a href="{{ .Path }}?page={{ .PrevPage }}">Previous</a>{{ end }}
  <span class="muted">Page {{ .Page }}</span>
  {{ if .HasNext }}<a href="{{ .Path }}?page={{ .NextPage }}">Next</a>{{ end }}
</nav>
{{ end }}
