{{- /*
customer.gohtml is one customer's page.

The addresses are the customer provider's list-valued field, in the order they
were written, each marked when it is a default (ADR 0308).
*/ -}}
{{ define "body" }}
<h1>{{ .Title }}</h1>

<div class="panel">
  <p>
    {{ if .Customer.HasAccount }}
      <span class="pill">registered</span>
    {{ else }}
      <span class="pill">guest</span>
    {{ end }}
    {{ if not .Customer.CreatedAt.IsZero }}
    <span class="muted">since {{ .Customer.CreatedAt.Format "2006-01-02" }}</span>
    {{ end }}
  </p>
</div>

<table>
  <tbody>
    <tr>
      <th>Email</th>
      <td>{{ if .Customer.Email }}{{ .Customer.Email }}{{ else }}<span class="muted">none</span>{{ end }}</td>
    </tr>
    <tr>
      <th>Phone</th>
      <td>{{ if .Customer.Phone }}{{ .Customer.Phone }}{{ else }}<span class="muted">none</span>{{ end }}</td>
    </tr>
    <tr><th>Identifier</th><td>{{ .Customer.ID }}</td></tr>
  </tbody>
</table>

<h2>Addresses</h2>
{{ if .Addresses }}
<table>
  <tbody>
    {{ range .Addresses }}
    <tr>
      <td>{{ range .Lines }}{{ . }}<br>{{ end }}</td>
      <td>
        {{ if .DefaultShipping }}<span class="pill">default shipping</span>{{ end }}
        {{ if .DefaultBilling }}<span class="pill">default billing</span>{{ end }}
      </td>
    </tr>
    {{ end }}
  </tbody>
</table>
{{ else }}
<p class="muted">No address is kept for this customer.</p>
{{ end }}

<p><a href="{{ .CustomersPath }}">Back to customers</a></p>
{{ end }}
