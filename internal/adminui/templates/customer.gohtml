{{- /*
customer.gohtml is one customer's page.

The addresses are the customer provider's list-valued field, in the order they
were written, each marked when it is a default (ADR 0308).

The groups are the customer's, in the order their rank gives them, named
through the customer module's group entity. A promotion or a price limited to
a group reaches the customer through them (ADR 0321). An operator who may
write the customers puts the customer into a group or takes them out (ADR
0322), and corrects their name and phone from the ones the page was drawn
with; the e-mail is what an account signs in with and is not corrected here
(ADR 0337).
*/ -}}
{{ define "body" }}
<h1>{{ .Title }}</h1>

{{ with .Refused }}<p role="alert">{{ . }}</p>{{ end }}
{{ if .Written }}<p role="status">The contact details were written.</p>{{ end }}

<div class="panel">
  <p>
    {{ if .Customer.HasAccount }}
      <span class="pill">registered</span>
    {{ else }}
      <span class="pill">guest</span>
    {{ end }}
    {{ if not .Customer.CreatedAt.IsZero }}
    <span class="muted">since {{ .Customer.CreatedAt.Format "2006-01-02" }}</span>
    {{ end }}
  </p>
</div>

<table>
  <tbody>
    <tr>
      <th>Email</th>
      <td>{{ if .Customer.Email }}{{ .Customer.Email }}{{ else }}<span class="muted">none</span>{{ end }}</td>
    </tr>
    <tr>
      <th>Phone</th>
      <td>{{ if .Customer.Phone }}{{ .Customer.Phone }}{{ else }}<span class="muted">none</span>{{ end }}</td>
    </tr>
    <tr><th>Identifier</th><td>{{ .Customer.ID }}</td></tr>
  </tbody>
</table>

{{ with .ContactForm }}
<details{{ if $.ContactRefused }} open{{ end }}>
  <summary>Correct the name and phone</summary>
  <form method="post" action="{{ $.CustomersPath }}/{{ $.Customer.ID }}/contact">
    <input type="hidden" name="read_first_name" value="{{ $.ContactRead.FirstName }}">
    <input type="hidden" name="read_last_name" value="{{ $.ContactRead.LastName }}">
    <input type="hidden" name="read_phone" value="{{ $.ContactRead.Phone }}">
    <input name="first_name" value="{{ .FirstName }}" placeholder="first name" aria-label="first name">
    <input name="last_name" value="{{ .LastName }}" placeholder="last name" aria-label="last name">
    <input name="phone" value="{{ .Phone }}" placeholder="phone" aria-label="phone" type="tel">
    <button type="submit">Write</button>
  </form>
</details>
{{ end }}

<h2>Addresses</h2>
{{ if .Addresses }}
<table>
  <tbody>
    {{ range .Addresses }}
    <tr>
      <td>{{ range .Lines }}{{ . }}<br>{{ end }}</td>
      <td>
        {{ if .DefaultShipping }}<span class="pill">default shipping</span>{{ end }}
        {{ if .DefaultBilling }}<span class="pill">default billing</span>{{ end }}
      </td>
    </tr>
    {{ end }}
  </tbody>
</table>
{{ else }}
<p class="muted">No address is kept for this customer.</p>
{{ end }}

<h2>Groups</h2>
{{ if .GroupsUnread }}<p class="muted">The groups' names could not be read; they are shown by id.</p>{{ end }}
{{ if .Groups }}
<table>
  <tbody>
    {{ range .Groups }}
    <tr>
      <td>{{ .Name }}</td>
      {{ if $.CanEditGroups }}<td>
        <form method="post" action="{{ $.CustomersPath }}/{{ $.Customer.ID }}/groups/{{ .ID }}/remove">
          <button type="submit">Take out of the group</button>
        </form>
      </td>{{ end }}
    </tr>
    {{ end }}
  </tbody>
</table>
{{ else }}
<p class="muted">The customer is in no group.</p>
{{ end }}

{{ with .GroupChoices }}
{{ if .Unavailable }}
<p class="muted">The customer groups could not be read, so none is offered.</p>
{{ else if .Options }}
<form method="post" action="{{ $.CustomersPath }}/{{ $.Customer.ID }}/groups">
  <select name="group_id" aria-label="customer group">
    {{ range .Options }}<option value="{{ .ID }}">{{ .Name }}</option>{{ end }}
  </select>
  <button type="submit">Put into the group</button>
</form>
{{ if .Truncated }}<p class="muted">Only the newest {{ .Offered }} groups are offered.</p>{{ end }}
{{ end }}
{{ end }}

<p><a href="{{ .CustomersPath }}">Back to customers</a></p>
{{ end }}
