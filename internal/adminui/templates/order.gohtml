{{- /*
order.gohtml is one order's page.

The lines come from the order module's line entity, the surface the sales report
reads (D96), in the order they were written, each add-on under its line.

Every amount is printed with its currency, and an amount whose scale could not
be read says it is in minor units instead of being divided by a guessed hundred.
*/ -}}
{{ define "body" }}
<h1>Order #{{ .Order.DisplayID }}</h1>

{{ with .Outcome }}
{{ if .Refused }}<p role="alert">{{ .Refused }}</p>{{ else }}<p role="status">{{ .Done }}</p>{{ end }}
{{ range .Warnings }}<p role="alert">{{ . }}</p>{{ end }}
{{ end }}

<div class="panel">
  <p>
    <span class="pill">{{ .Order.Status }}</span>
    {{ if not .Order.PlacedAt.IsZero }}
    <span class="muted">placed {{ .Order.PlacedAt.Format "2006-01-02 15:04" }}</span>
    {{ end }}
    {{ with .Order.PlacedBy }}<span class="muted">by operator {{ . }}</span>{{ end }}
  </p>
  <p>
    {{ if .Order.Email }}{{ .Order.Email }}{{ else }}<span class="muted">no address on this order</span>{{ end }}
  </p>
  {{ if $.CanCancel }}
  {{/* An order the checkout placed and nobody paid for yet is canceled here,
  its units written off so their stock comes back (ADR 0339); one with money
  collected is refused, and is settled through its after-sales records. */}}
  <details>
    <summary>Cancel the order</summary>
    <form method="post" action="{{ $.OrdersPath }}/{{ $.Order.ID }}/cancel">
      <input name="reason" placeholder="why, kept with the order" aria-label="reason">
      <button type="submit">Cancel the order</button>
    </form>
  </details>
  {{ end }}
  {{ with .Order.Parent }}
  <p>Adds to <a href="{{ $.OrdersPath }}/{{ .ID }}">{{ if .DisplayID }}#{{ .DisplayID }}{{ else }}{{ .ID }}{{ end }}</a></p>
  {{ end }}
</div>

{{/*
The addresses are the order's CURRENT ones (ADR 0196). A corrected shipping
address says when it was corrected; the address it replaced is on the order's
timeline and in the person's file, not here.
*/}}
<h2>Addresses</h2>

<table>
  <tbody>
    <tr>
      <th>Ship to</th>
      <td>
        {{ range .Order.ShipTo }}{{ . }}<br>{{ else }}<span class="muted">no shipping address</span>{{ end }}
        {{ if not .Order.CorrectedAt.IsZero }}
        <span class="muted">corrected {{ .Order.CorrectedAt.Format "2006-01-02 15:04" }} UTC</span>
        {{ end }}
      </td>
    </tr>
    <tr>
      <th>Bill to</th>
      <td>{{ range .Order.BillTo }}{{ . }}<br>{{ else }}<span class="muted">no billing address</span>{{ end }}</td>
    </tr>
  </tbody>
</table>

<h2>Lines</h2>

{{ if .Order.LinesUnread }}
<p class="muted">The lines of this order could not be read.</p>
{{ else if .Order.Lines }}
<table>
  <thead>
    <tr>
      <th>Item</th><th class="num">Quantity</th><th class="num">Unit price</th>
      <th class="num">Subtotal</th><th class="num">Discount</th><th class="num">Tax</th>
      <th class="num">Total</th><th class="num">Asked back</th><th class="num">Canceled</th>
    </tr>
  </thead>
  <tbody>
    {{ range .Order.Lines }}
    <tr>
      <td>
        {{ if .AddOn }}<span class="muted">add-on:</span> {{ end }}{{ .Title }}
        {{ if .GiftCard }}<span class="pill">gift card</span>{{ end }}
        <br><span class="muted">{{ .VariantID }}</span>
        {{ range .Properties }}<br><span class="muted">{{ . }}</span>{{ end }}
      </td>
      <td class="num">{{ .Quantity }}</td>
      <td class="num">{{ .UnitPrice }}</td>
      <td class="num">{{ .Subtotal }}</td>
      <td class="num">{{ .Discount }}</td>
      <td class="num">{{ .Tax }}</td>
      <td class="num">{{ .Total }}</td>
      <td class="num">{{ .AskedBack }}</td>
      <td class="num">{{ .Canceled }}</td>
    </tr>
    {{ end }}
  </tbody>
</table>
<p class="muted">
  Amounts in {{ .Order.Currency }}{{ if .Order.Minor }}, in minor units{{ end }}.
  {{ if .Order.LinesMore }}Only the first {{ $.LinesPerOrder }} lines are shown.{{ end }}
</p>
{{ else }}
<p class="muted">This order has no lines.</p>
{{ end }}

<h2>Amounts</h2>

<table>
  <tbody>
    <tr><th>Subtotal</th><td class="num">{{ .Order.Subtotal }} {{ .Order.Currency }}</td></tr>
    <tr><th>Discount</th><td class="num">{{ .Order.Discount }} {{ .Order.Currency }}</td></tr>
    <tr><th>Tax</th><td class="num">{{ .Order.Tax }} {{ .Order.Currency }}</td></tr>
    <tr><th>Shipping</th><td class="num">{{ .Order.Shipping }} {{ .Order.Currency }}</td></tr>
    <tr>
      <th>Total</th>
      <td class="num">
        <strong>{{ .Order.Total }} {{ .Order.Currency }}</strong>
        {{ if .Order.Minor }}<span class="muted">(minor units)</span>{{ end }}
      </td>
    </tr>
  </tbody>
</table>

{{/*
The payment and the parcels are other modules' data, reached through the
order's links. Each is read and printed only for an operator holding that
module's own privilege (ADR 0251); the order's privilege opens the page.
*/}}
<h2>Payment</h2>

{{ if .Order.PaymentHidden }}
<p class="muted">Reading the payment needs the {{ .PaymentPrivilege }} privilege.</p>
{{ else if .Order.PaymentUnread }}
<p class="muted">The payment of this order could not be read.</p>
{{ else if .Order.Payment }}
{{ with .Order.Payment }}
<table>
  <tbody>
    <tr><th>Status</th><td><span class="pill">{{ .Status }}</span></td></tr>
    <tr><th>Amount</th><td class="num">{{ .Amount }} {{ .Currency }}</td></tr>
    <tr><th>Authorized</th><td class="num">{{ .Authorized }} {{ .Currency }}</td></tr>
    <tr>
      <th>Captured</th>
      <td class="num">
        {{ .Captured }} {{ .Currency }}
        {{ with .FirstCapturedAt }}<span class="muted">first {{ .Format "2006-01-02 15:04" }} UTC</span>{{ end }}
      </td>
    </tr>
    <tr>
      <th>Refunded</th>
      <td class="num">
        {{ .Refunded }} {{ .Currency }}
        {{ with .LastRefundedAt }}<span class="muted">last {{ .Format "2006-01-02 15:04" }} UTC</span>{{ end }}
      </td>
    </tr>
  </tbody>
</table>
{{ range .Awaiting }}
{{/* An offline method's money arrives after the order (ADR 0287). */}}
<p>
  Awaiting <span class="num">{{ .Amount }} {{ $.Order.Payment.Currency }}</span> by {{ .Method }}.
  {{ if $.CanRecordPayment }}
  <form method="post" action="{{ $.OrdersPath }}/{{ $.Order.ID }}/payment/{{ .SessionID }}/received">
    <button type="submit">Record the money as received</button>
  </form>
  {{ end }}
</p>
{{ end }}
{{ end }}
{{ else }}
<p class="muted">No payment is linked to this order.</p>
{{ end }}

<h2>Parcels</h2>

{{ if .Order.ParcelsHidden }}
<p class="muted">Reading the parcels needs the {{ .FulfillmentPrivilege }} privilege.</p>
{{ else if .Order.ParcelsUnread }}
<p class="muted">The parcels of this order could not be read.</p>
{{ else if .Order.Parcels }}
<table>
  <thead><tr><th>Status</th><th>Holds</th><th>Tracking</th><th>Opened</th><th>Moments</th>{{ if .CanMoveParcels }}<th>Move</th>{{ end }}</tr></thead>
  <tbody>
    {{ range $parcel := .Order.Parcels }}
    <tr>
      <td><span class="pill">{{ .Status }}</span></td>
      <td>{{ range .Holds }}{{ . }}<br>{{ else }}<span class="muted">nothing listed</span>{{ end }}</td>
      <td>
        {{ if and .TrackingNumber .TrackingURL }}<a href="{{ .TrackingURL }}" rel="noopener noreferrer">{{ .TrackingNumber }}</a>
        {{ else if .TrackingNumber }}{{ .TrackingNumber }}
        {{ else }}<span class="muted">no tracking</span>{{ end }}
      </td>
      <td>{{ if not .CreatedAt.IsZero }}{{ .CreatedAt.Format "2006-01-02 15:04" }}{{ end }}</td>
      <td>
        {{ with .ShippedAt }}shipped {{ .Format "2006-01-02 15:04" }}<br>{{ end }}
        {{ with .DeliveredAt }}delivered {{ .Format "2006-01-02 15:04" }}<br>{{ end }}
        {{ with .CanceledAt }}canceled {{ .Format "2006-01-02 15:04" }}<br>{{ end }}
        {{ with .ReturnedAt }}returned {{ .Format "2006-01-02 15:04" }}{{ end }}
      </td>
      {{ if $.CanMoveParcels }}<td>
        {{ range index $.ParcelMoves $parcel.Status }}
        <form method="post" action="{{ $.OrdersPath }}/{{ $.Order.ID }}/parcels/{{ $parcel.ID }}/{{ .Act }}">
          {{ if .Tracking }}<input name="tracking_number" placeholder="tracking number" aria-label="tracking number">
          <input name="tracking_url" placeholder="tracking page" aria-label="tracking page">{{ end }}
          <button type="submit">{{ .Label }}</button>
        </form>
        {{ end }}
      </td>{{ end }}
    </tr>
    {{ end }}
  </tbody>
</table>
{{ else }}
<p class="muted">No parcel has been opened for this order.</p>
{{ end }}
{{/*
A parcel is opened by the order module on the delivery the order was sold, and
moved by the fulfillment module (ADR 0324). The open form carries a key drawn
with the page, so a second press, or a reload of the page it lands on, opens
nothing new. An order sold several deliveries is asked which one the parcel
goes on, and the module sends it on the option that delivery stands on when
the form is sent (ADR 0332).
*/}}
{{ with .ParcelOpening }}
{{ if .NoDelivery }}
<p class="muted">This order was sold no delivery, so there is none to open a parcel on.</p>
{{ else }}
<form method="post" action="{{ $.OrdersPath }}/{{ $.Order.ID }}/parcels">
  <input type="hidden" name="key" value="{{ .Key }}">
  {{ with .Deliveries }}<select name="delivery" aria-label="delivery" required>
    {{ range . }}<option value="{{ .ID }}">{{ .Name }} ({{ .ShippingOptionID }})</option>{{ end }}
  </select>{{ end }}
  <button type="submit">Open a parcel</button>
</form>
{{ end }}
{{ end }}

{{ with .Invoice }}
<h2>Invoice</h2>
{{/*
The order's invoice is named by the order module and issued through the
invoicing flow the API calls (ADR 0335). The series an invoice is numbered
on are the invoice module's, offered to an operator who may read them; a
prefix not used before opens a new series with its first invoice, which is
why a new one is named apart from the ones the shop has.
*/}}
{{ if .Unread }}
<p class="muted">The invoice of this order could not be read.</p>
{{ else if .Found }}
<p>Invoice <strong>{{ .Number }}</strong> <span class="pill">{{ .Status }}</span> <span class="muted">{{ .ID }}</span></p>
{{ else }}
<p class="muted">No invoice has been issued for this order.</p>
{{ end }}
{{ if .CanIssue }}
<form method="post" action="{{ $.OrdersPath }}/{{ $.Order.ID }}/invoice">
  {{ with .Prefixes }}<select name="series" aria-label="series">
    {{ range . }}<option value="{{ . }}">{{ . }}</option>{{ end }}
  </select>{{ end }}
  <input name="new_series" placeholder="{{ if .Prefixes }}or a new series{{ else }}series, e.g. GBT{{ end }}" aria-label="new series" maxlength="3">
  <input name="buyer_name" placeholder="buyer, or as billed" aria-label="buyer">
  <input name="buyer_address" placeholder="address, or as billed" aria-label="buyer's address">
  <input name="buyer_country" placeholder="country, or as billed" aria-label="buyer's country" maxlength="2">
  <input name="tax_number" placeholder="buyer's tax number" aria-label="tax number">
  <input name="tax_office" placeholder="buyer's tax office" aria-label="tax office">
  <button type="submit">Issue the invoice</button>
</form>
<p class="muted">A series not used before is opened by its first invoice. The buyer is the order's billing address where it is left empty.</p>
{{ end }}
{{ end }}

{{ if .NotificationsShown }}
{{/*
What the notification module sent for the order (ADR 0318), read only for an
operator holding its privilege; a failed confirmation is sent again on the
Notifications screen, which the link opens on this order.
*/}}
<h2>Notifications</h2>

{{ if .Order.NotificationsHidden }}
<p class="muted">Reading the notifications needs the {{ .NotificationPrivilege }} privilege.</p>
{{ else if .Order.NotificationsUnread }}
<p class="muted">The notifications of this order could not be read.</p>
{{ else }}
{{ if .Order.Notifications }}
<table>
  <thead><tr><th>Notification</th><th>Channel</th><th>Status</th><th>Last change (UTC)</th></tr></thead>
  <tbody>
    {{ range .Order.Notifications }}
    <tr>
      <td>{{ .Template }}</td>
      <td>{{ .Channel }}</td>
      <td><span class="pill">{{ .Status }}</span>{{ with .Error }}<br><span class="muted">{{ . }}</span>{{ end }}</td>
      <td>{{ .UpdatedAt.UTC.Format "2006-01-02 15:04" }}</td>
    </tr>
    {{ end }}
  </tbody>
</table>
{{ if .Order.NotificationsMore }}<p class="muted">Only the latest {{ .NotificationsPerOrder }} are shown.</p>{{ end }}
{{ else }}
<p class="muted">Nothing has been sent for this order.</p>
{{ end }}
<p><a href="{{ .NotificationsPath }}?reference={{ .Order.ID }}">The order's notifications</a>, where a failed confirmation is sent again.</p>
{{ end }}
{{ end }}

<h2>After-sales</h2>

{{ if .Order.AfterSalesUnread }}
<p class="muted">The after-sales records of this order could not be read.</p>
{{ else if .Order.AfterSales }}
<table>
  <thead><tr><th>Record</th><th>Status</th><th>Goods</th><th>Money</th><th>Opened</th><th>Since</th>{{ if $.CanAct }}<th>Act</th>{{ end }}</tr></thead>
  <tbody>
    {{ range $sale := .Order.AfterSales }}
    <tr>
      <td>{{ .Kind }} <span class="muted">{{ .ID }}</span>{{ range .Detail }}<br><span class="muted">{{ . }}</span>{{ end }}
        {{ if .EvidenceUnread }}<br><span class="muted">The evidence could not be read.</span>{{ end }}
        {{ range .Evidence }}
        <br>evidence: {{ if .URL }}<a href="{{ .URL }}" rel="noopener noreferrer">{{ with .Caption }}{{ . }}{{ else }}the file{{ end }}</a>{{ else }}{{ with .Caption }}{{ . }}{{ else }}a file{{ end }} <span class="muted">{{ .UploadID }}</span>{{ end }}
        {{ if $.CanDetachEvidence }}<form method="post" action="{{ $.OrdersPath }}/{{ $.Order.ID }}/claims/{{ $sale.ID }}/evidence/{{ .ID }}/detach">
          <button type="submit">Remove the evidence</button>
        </form>{{ end }}
        {{ end }}
      </td>
      <td><span class="pill">{{ .Status }}</span></td>
      <td>{{ range .Goods }}{{ . }}<br>{{ else }}<span class="muted">none listed</span>{{ end }}</td>
      <td>{{ if .Money }}{{ .Money }}{{ else }}<span class="muted">none</span>{{ end }}</td>
      <td>{{ if not .OpenedAt.IsZero }}{{ .OpenedAt.Format "2006-01-02 15:04" }}{{ end }}</td>
      <td>{{ range .Since }}{{ . }}<br>{{ end }}</td>
      {{ if $.CanAct }}
      <td>
        {{ range .Forms }}
        <form method="post" action="{{ $.OrdersPath }}/{{ $.Order.ID }}/after-sales/{{ $sale.Kind }}/{{ $sale.ID }}/{{ .Act }}">
          {{ if .Location }}<input name="location_id" placeholder="stock location" aria-label="stock location" required>{{ end }}
          {{ if .Collection }}<input name="collection_id" placeholder="payment collection" aria-label="payment collection" required>{{ end }}
          {{ if .Amount }}<input name="amount" inputmode="decimal" placeholder="{{ .AmountHint }}" aria-label="amount{{ if $.Order.Minor }} in minor units{{ end }}">
          <input type="hidden" name="currency" value="{{ $.Order.Currency }}">{{ if $.Order.Minor }}<input type="hidden" name="minor" value="1">{{ end }}{{ end }}
          {{ if .Reason }}<input name="reason" placeholder="reason" aria-label="reason">{{ end }}
          <button type="submit">{{ .Label }}</button>
        </form>
        {{ end }}
        {{ if and (eq $sale.Kind "claim") $.CanAttachEvidence }}
        {{/* A photograph of the damage or the short delivery (ADR 0325); the file
        module checks its type and size. */}}
        <form method="post" action="{{ $.OrdersPath }}/{{ $.Order.ID }}/claims/{{ $sale.ID }}/evidence" enctype="multipart/form-data">
          <input name="caption" placeholder="what it shows" aria-label="what the file shows">
          <input type="file" name="file" aria-label="evidence file" required>
          <button type="submit">Attach evidence</button>
        </form>
        {{ end }}
      </td>
      {{ end }}
    </tr>
    {{ end }}
  </tbody>
</table>
{{ if .Order.AfterSalesMore }}<p class="muted">Only the latest {{ .AfterSalesPerKind }} records of each kind are shown.</p>{{ end }}
{{ else }}
<p class="muted">No return, claim, exchange or replacement has been opened for this order.</p>
{{ end }}

{{ if and .CanAct (not .Order.AfterSalesUnread) }}
<h3>Open a record</h3>

{{ if .Order.Lines }}
<form method="post" action="{{ .OrdersPath }}/{{ .Order.ID }}/after-sales/return">
  <p>A return: the units coming back, and each line's part of the refund.</p>
  {{ template "order-return-lines" . }}
  <input name="amount" inputmode="decimal" placeholder="refund planned (optional)" aria-label="refund planned">
  <input type="hidden" name="currency" value="{{ .Order.Currency }}">{{ if .Order.Minor }}<input type="hidden" name="minor" value="1">{{ end }}
  <input name="reason" placeholder="reason" aria-label="reason">
  <button type="submit">Open a return</button>
</form>
{{ end }}

<form method="post" action="{{ .OrdersPath }}/{{ .Order.ID }}/after-sales/claim">
  <p>A claim: goods that arrived damaged or short.</p>
  <select name="type" aria-label="settled by">
    <option value="refund">settled by a refund</option>
    <option value="replace">settled by a replacement</option>
  </select>
  <input name="amount" inputmode="decimal" placeholder="refund (a refund claim)" aria-label="refund">
  <input type="hidden" name="currency" value="{{ .Order.Currency }}">{{ if .Order.Minor }}<input type="hidden" name="minor" value="1">{{ end }}
  <input name="reason" placeholder="reason" aria-label="reason">
  <button type="submit">Open a claim</button>
</form>

<form method="post" action="{{ .OrdersPath }}/{{ .Order.ID }}/after-sales/exchange">
  <p>An exchange: the difference, negative when the customer is paid.</p>
  <input name="amount" inputmode="decimal" placeholder="difference" aria-label="difference" required>
  <input type="hidden" name="currency" value="{{ .Order.Currency }}">{{ if .Order.Minor }}<input type="hidden" name="minor" value="1">{{ end }}
  <input name="note" placeholder="note" aria-label="note">
  <button type="submit">Open an exchange</button>
</form>

{{ if and .ReplacementSources .Order.Lines }}
<form method="post" action="{{ .OrdersPath }}/{{ .Order.ID }}/after-sales/replacement">
  <p>A replacement: what a claim or an exchange sends.</p>
  <select name="source" aria-label="settles">
    {{ range .ReplacementSources }}<option value="{{ .Value }}">{{ .Label }}</option>{{ end }}
  </select>
  {{ template "order-line-quantities" . }}
  <label>another variant
    <input name="variant_id" placeholder="variant id" aria-label="another variant to send">
    <input name="variant_quantity" inputmode="numeric" placeholder="0" aria-label="units of that variant">
  </label>
  <input name="shipping_option_id" placeholder="shipping option" aria-label="shipping option" required>
  <input name="location_id" placeholder="stock location" aria-label="stock location" required>
  <button type="submit">Open a replacement</button>
</form>
{{ end }}
{{ end }}

<h2>Additions</h2>

{{ if .Order.AdditionsUnread }}
<p class="muted">The additions to this order could not be read.</p>
{{ else if .Order.Additions }}
<table>
  <thead><tr><th>Order</th><th>Status</th><th class="num">Total</th></tr></thead>
  <tbody>
    {{ range .Order.Additions }}
    <tr>
      <td><a href="{{ $.OrdersPath }}/{{ .ID }}">#{{ .DisplayID }}</a></td>
      <td><span class="pill">{{ .Status }}</span></td>
      <td class="num">{{ .Total }} {{ .Currency }}{{ if .Minor }} <span class="muted">(minor units)</span>{{ end }}</td>
    </tr>
    {{ end }}
  </tbody>
</table>
{{ else }}
<p class="muted">Nothing has been added to this order.</p>
{{ end }}

<p><a href="{{ .OrdersPath }}">Back to orders</a></p>
{{ end }}

{{/* order-return-lines is a quantity box for each of the order's lines and
the line's part of the refund beside it, for a return to name what comes back
(ADR 0272, ADR 0279). */}}
{{ define "order-return-lines" }}
{{ range .Order.Lines }}
<label>{{ .Title }} <span class="muted">of {{ .Quantity }}</span>
  <input type="hidden" name="line_id" value="{{ .ID }}">
  <input name="quantity" inputmode="numeric" placeholder="0" aria-label="units of {{ .Title }}">
  <input name="line_refund" inputmode="decimal" placeholder="its refund" aria-label="refund of {{ .Title }}{{ if $.Order.Minor }} in minor units{{ end }}">
</label>
{{ end }}
{{ end }}

{{/* order-line-quantities is a quantity box for each of the order's lines, for a
replacement to name which of them it sends more of (ADR 0272). */}}
{{ define "order-line-quantities" }}
{{ range .Order.Lines }}
<label>{{ .Title }} <span class="muted">of {{ .Quantity }}</span>
  <input type="hidden" name="line_id" value="{{ .ID }}">
  <input name="quantity" inputmode="numeric" placeholder="0" aria-label="units of {{ .Title }}">
</label>
{{ end }}
{{ end }}
