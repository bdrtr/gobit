{{- /*
order.gohtml is one order's page.

The LINES are absent because nobody has written them yet. The reason this comment
used to give — that the read layer joins across links and not within a module —
was false, and the sales report in this same package disproves it by reading the
order line entity through the same surface (D96). What this screen answers today
is the question an operator opens an order for: who, when, how much, and where it
stands.

Every amount is printed with its currency, and an amount whose scale could not
be read says it is in minor units instead of being divided by a guessed hundred.
*/ -}}
{{ define "body" }}
<h1>Order #{{ .Order.DisplayID }}</h1>

<div class="panel">
  <p>
    <span class="pill">{{ .Order.Status }}</span>
    {{ if not .Order.PlacedAt.IsZero }}
    <span class="muted">placed {{ .Order.PlacedAt.Format "2006-01-02 15:04" }}</span>
    {{ end }}
  </p>
  <p>
    {{ if .Order.Email }}{{ .Order.Email }}{{ else }}<span class="muted">no address on this order</span>{{ end }}
  </p>
  {{ with .Order.Parent }}
  <p>Adds to <a href="{{ $.OrdersPath }}/{{ .ID }}">{{ if .DisplayID }}#{{ .DisplayID }}{{ else }}{{ .ID }}{{ end }}</a></p>
  {{ end }}
</div>

{{/*
The addresses are the order's CURRENT ones (ADR 0196). A corrected shipping
address says when it was corrected; the address it replaced is on the order's
timeline and in the person's file, not here.
*/}}
<h2>Addresses</h2>

<table>
  <tbody>
    <tr>
      <th>Ship to</th>
      <td>
        {{ range .Order.ShipTo }}{{ . }}<br>{{ else }}<span class="muted">no shipping address</span>{{ end }}
        {{ if not .Order.CorrectedAt.IsZero }}
        <span class="muted">corrected {{ .Order.CorrectedAt.Format "2006-01-02 15:04" }} UTC</span>
        {{ end }}
      </td>
    </tr>
    <tr>
      <th>Bill to</th>
      <td>{{ range .Order.BillTo }}{{ . }}<br>{{ else }}<span class="muted">no billing address</span>{{ end }}</td>
    </tr>
  </tbody>
</table>

<h2>Amounts</h2>

<table>
  <tbody>
    <tr><th>Subtotal</th><td class="num">{{ .Order.Subtotal }} {{ .Order.Currency }}</td></tr>
    <tr><th>Discount</th><td class="num">{{ .Order.Discount }} {{ .Order.Currency }}</td></tr>
    <tr><th>Tax</th><td class="num">{{ .Order.Tax }} {{ .Order.Currency }}</td></tr>
    <tr><th>Shipping</th><td class="num">{{ .Order.Shipping }} {{ .Order.Currency }}</td></tr>
    <tr>
      <th>Total</th>
      <td class="num">
        <strong>{{ .Order.Total }} {{ .Order.Currency }}</strong>
        {{ if .Order.Minor }}<span class="muted">(minor units)</span>{{ end }}
      </td>
    </tr>
  </tbody>
</table>

<h2>Additions</h2>

{{ if .Order.AdditionsUnread }}
<p class="muted">The additions to this order could not be read.</p>
{{ else if .Order.Additions }}
<table>
  <thead><tr><th>Order</th><th>Status</th><th class="num">Total</th></tr></thead>
  <tbody>
    {{ range .Order.Additions }}
    <tr>
      <td><a href="{{ $.OrdersPath }}/{{ .ID }}">#{{ .DisplayID }}</a></td>
      <td><span class="pill">{{ .Status }}</span></td>
      <td class="num">{{ .Total }} {{ .Currency }}{{ if .Minor }} <span class="muted">(minor units)</span>{{ end }}</td>
    </tr>
    {{ end }}
  </tbody>
</table>
{{ else }}
<p class="muted">Nothing has been added to this order.</p>
{{ end }}

<p><a href="{{ .OrdersPath }}">Back to orders</a></p>
{{ end }}
