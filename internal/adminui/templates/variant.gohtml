{{- /*
variant.gohtml is where a variant's price and stock are edited.

The two forms sit on one page because they are read in one place and changed in
the same sitting; splitting them would cost a second read of the same variant.

Two things are printed that a simpler page would leave out, and both exist to
stop a rejection from looking arbitrary:

  - The RESERVED quantity. Stock cannot be set below what is already promised to
    a sale, and a form showing only the physical count would make that refusal
    unexplainable.
  - Whether an amount is in MINOR UNITS. When the currency's scale is unknown the
    box takes a raw integer, and an operator typing "199.90" into it would store
    a hundredth of what they meant.

Every location is listed, including the ones holding nothing: a location that
only appeared once it had stock could never be stocked from this form.

A bundle (ADR 0236) lists its parts, each linked to the part's own page where its
stock is kept, and says it counts none of its own in place of the stock table.

The prices are read and printed only for an operator holding pricing:read, and
the stock only for one holding inventory:read (ADR 0260); without the grant the
section names it.
*/ -}}
{{ define "body" }}
<p><a href="{{ .ProductPath }}">← Back to the product</a></p>

<h1>{{ .Variant.Title }}</h1>
<p>SKU: {{ if .Variant.SKU }}{{ .Variant.SKU }}{{ else }}—{{ end }}</p>

{{ if .Error }}<p role="alert">{{ .Error }}</p>{{ end }}

<h2>Prices</h2>
{{ if .Access.PricesHidden }}
  <p class="muted">Reading the prices needs the {{ .Access.PricingPrivilege }} privilege.</p>
{{ else if .PriceSetID }}
  {{ if .Prices }}
    {{ $canEdit := .CanEdit }}
    {{ $path := .PricePath }}
    {{ $setID := .PriceSetID }}
    {{ range .Prices }}
      <form method="post" action="{{ $path }}">
        <input type="hidden" name="price_set_id" value="{{ $setID }}">
        <input type="hidden" name="currency" value="{{ .Currency }}">
        <input type="hidden" name="minor" value="{{ if .Minor }}1{{ else }}0{{ end }}">
        <input type="hidden" name="read_amount" value="{{ .Amount }}">
        <label>{{ .Currency }}{{ if .Minor }} (minor units){{ end }}
          <input type="text" name="amount" value="{{ .Amount }}" required>
        </label>
        <button type="submit"{{ if not $canEdit }} disabled{{ end }}>Save price</button>
      </form>
    {{ end }}
  {{ else }}
    <p>This variant's price set has no single base price at one unit to edit here. Add or change one through the admin API.</p>
  {{ end }}
  {{ if .ListPricesUnread }}<p class="muted">The variant's prices on price lists could not be read.</p>{{ end }}
  {{ if .ListPrices }}
    {{/* A price on a list, for every customer or for some groups, read through
    the pricing module's surface with its rules (ADR 0327). */}}
    <h3>Prices on price lists</h3>
    <table>
      <thead>
        <tr><th>Price list</th><th>Amount</th><th>Applies to</th>{{ if .CanRemoveList }}<th></th>{{ end }}</tr>
      </thead>
      <tbody>
      {{ range .ListPrices }}
        <tr><td>{{ .List }}</td><td>{{ .Amount }}</td><td>{{ .Applies }}</td>
          {{ if $.CanRemoveList }}<td>
            <form method="post" action="{{ $.ListPricesPath }}/{{ .ID }}/remove">
              <input type="hidden" name="price_set_id" value="{{ $.PriceSetID }}">
              <button type="submit">Remove</button>
            </form>
          </td>{{ end }}
        </tr>
      {{ end }}
      </tbody>
    </table>
  {{ end }}
  {{ with .ListPriceForm }}
  {{ if .Lists }}
  <form method="post" action="{{ $.ListPricesPath }}">
    <input type="hidden" name="price_set_id" value="{{ $.PriceSetID }}">
    <select name="price_list_id" aria-label="price list" required>
      {{ range .Lists }}<option value="{{ .ID }}">{{ .Title }} ({{ .Type }}, {{ .Status }})</option>{{ end }}
    </select>
    <select name="currency" aria-label="currency" required>
      {{ range .Currencies }}<option value="{{ . }}">{{ . }}</option>{{ end }}
    </select>
    <input type="text" name="amount" placeholder="amount" aria-label="amount" required>
    {{ if .Groups }}
    <select name="customer_group" multiple aria-label="customer groups" size="4">
      {{ range .Groups }}<option value="{{ .ID }}">{{ .Name }}</option>{{ end }}
    </select>
    {{ end }}
    <button type="submit">Add the price on the list</button>
    <p class="muted">With no group chosen, the price is for every customer.</p>
  </form>
  {{ else }}
  <p class="muted">No price list has been written; write one on the Price lists screen.</p>
  {{ end }}
  {{ end }}
  {{ if .OtherPrices }}
    <h3>Other prices</h3>
    <p>Quantity tiers are changed through the admin API.</p>
    <table>
      <thead>
        <tr><th>Currency</th><th>Amount</th><th>Applies to</th></tr>
      </thead>
      <tbody>
      {{ range .OtherPrices }}
        <tr><td>{{ .Currency }}</td><td>{{ .Amount }}{{ if .Minor }} (minor units){{ end }}</td><td>{{ .Applies }}</td></tr>
      {{ end }}
      </tbody>
    </table>
  {{ end }}
{{ else }}
  <p>This variant is not linked to a price set.</p>
{{ end }}
{{ if and .CanAddPrice .NewCurrencies }}
{{/* A base price in a currency the variant has none in; its price set is created and linked first when it has none (ADR 0309). */}}
<form method="post" action="{{ .PricesPath }}">
  <select name="currency" aria-label="currency" required>
    {{ range .NewCurrencies }}<option value="{{ . }}">{{ . }}</option>{{ end }}
  </select>
  <input type="text" name="amount" placeholder="amount" aria-label="amount" required>
  <button type="submit">Add the price</button>
</form>
{{ end }}

{{/*
What one unit costs the shop, one cost per currency, net of tax (ADR 0401). A
form writes one currency's cost from the cost it was drawn with, so a cost
another operator changed since is refused rather than overwritten, and an empty
amount clears it (ADR 0412). The checkout copies the cost in the order's
currency onto the order line.
*/}}
<h2>Unit cost</h2>
{{ if .Costs }}
  {{ range .Costs }}
    {{ if $.CanCost }}
    <form method="post" action="{{ $.CostPath }}">
      <input type="hidden" name="currency" value="{{ .Currency }}">
      <input type="hidden" name="read_amount" value="{{ .Amount }}">
      <label>{{ .Currency }}{{ if .Minor }} (minor units){{ end }}
        <input type="text" name="amount" value="{{ .Amount }}" aria-label="cost in {{ .Currency }}">
      </label>
      <button type="submit">Save cost</button>
    </form>
    {{ else }}
    <p>{{ .Currency }}: {{ .Amount }}{{ if .Minor }} (minor units){{ end }}</p>
    {{ end }}
  {{ end }}
  {{ if $.CanCost }}<p class="muted">An empty amount clears the cost in that currency.</p>{{ end }}
{{ else }}
  <p class="muted">No unit cost is written for this variant.</p>
{{ end }}
{{ if and .CanCost .NewCostCurrencies }}
<form method="post" action="{{ .CostPath }}">
  <input type="hidden" name="read_amount" value="">
  <select name="currency" aria-label="cost currency" required>
    {{ range .NewCostCurrencies }}<option value="{{ . }}">{{ . }}</option>{{ end }}
  </select>
  <input type="text" name="amount" placeholder="cost" aria-label="cost" required>
  <button type="submit">Add the cost</button>
</form>
{{ end }}

<h2>Bundle</h2>
{{ if .Parts }}
  <p>One of this variant holds these parts. Its stock is theirs: the storefront
  shows it in stock while every part can supply its units for one, and a sale
  reserves the parts.</p>
  <ol>
  {{ range .Parts }}
    <li>{{ .Quantity }} × <a href="{{ $.ProductsPath }}/{{ .ProductID }}/variants/{{ .VariantID }}">{{ .ProductTitle }} — {{ .VariantTitle }}</a>{{ if .SKU }} ({{ .SKU }}){{ end }}</li>
  {{ end }}
  </ol>
{{ else }}
  <p>This variant is no bundle.</p>
{{ end }}
{{ if .CanBundle }}<p><a href="{{ .BundlePath }}">Edit the parts</a></p>{{ end }}

<h2>Stock</h2>
{{ with .StockFilled }}<p role="status">The count was saved. {{ . }} of these units went to orders that were waiting for them.</p>{{ end }}
{{ if .Parts }}
  <p>A bundle counts no stock of its own; its parts' pages hold theirs.</p>
{{ else if .Access.StockHidden }}
  <p class="muted">Reading the stock needs the {{ .Access.InventoryPrivilege }} privilege.</p>
{{ else if .ItemID }}
  {{ if .Levels }}
    {{ $canStock := .CanStock }}
    {{ $stockPath := .StockPath }}
    {{ $itemID := .ItemID }}
    <table>
      <thead>
        <tr><th>Location</th><th>Reserved</th><th>Available</th><th>Physical</th></tr>
      </thead>
      <tbody>
      {{ range .Levels }}
        <tr>
          <td>{{ .LocationName }}</td>
          <td>{{ .ReservedQuantity }}</td>
          <td>{{ .AvailableQuantity }}</td>
          <td>
            <form method="post" action="{{ $stockPath }}">
              <input type="hidden" name="inventory_item_id" value="{{ $itemID }}">
              <input type="hidden" name="location_id" value="{{ .LocationID }}">
              <input type="hidden" name="read_quantity" value="{{ .StockedQuantity }}">
              <input type="number" name="quantity" value="{{ .StockedQuantity }}" min="0" required>
              <button type="submit"{{ if not $canStock }} disabled{{ end }}>Save</button>
            </form>
          </td>
        </tr>
      {{ end }}
      </tbody>
    </table>
  {{ else }}
    <p>No stock locations were read. Create one through the admin API, or check the log.</p>
  {{ end }}
{{ else }}
  <p>This variant is not linked to an inventory item.</p>
  {{ if .CanKeepStock }}
  {{/* The item is made by inventory and linked by the product module; its levels are then set above (ADR 0310). */}}
  <form method="post" action="{{ .StockItemPath }}">
    <button type="submit">Keep this variant's stock</button>
  </form>
  {{ end }}
{{ end }}
{{ end }}
