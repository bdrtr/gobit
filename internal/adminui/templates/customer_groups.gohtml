{{- /*
customer_groups.gohtml lists the shop's customer groups (ADR 0323).

A group is a segment a price or a promotion can be limited to (ADR 0049, ADR
0321). A customer in several groups is priced by the one that ranks first,
and the smaller rank ranks first; a promotion limited to groups applies to a
customer in any of them. The rows come newest first, through the customer
module's group entity.

An operator who may write the customers writes a group here and puts
customers into it on their pages (ADR 0322). Each row's form renames and
re-ranks its group; it carries the name and the rank the row was drawn with,
and the module refuses when another operator revised the group first (ADR
0329).
*/ -}}
{{ define "body" }}
<h1>{{ .Title }}</h1>

{{ with .Refused }}<p role="alert">{{ . }}</p>{{ end }}
{{ with .Created }}<p role="status">Group {{ . }} was written.</p>{{ end }}

{{ if .CanCreate }}
<details{{ if .Typed }} open{{ end }}>
  <summary>New group</summary>
  <form method="post" action="{{ .Path }}">
    <input name="name" value="{{ .Typed.Get "name" }}" placeholder="name, e.g. Wholesale" aria-label="name" required>
    <input name="rank" value="{{ .Typed.Get "rank" }}" placeholder="rank, 0 if blank" aria-label="rank" inputmode="numeric">
    <button type="submit">Write the group</button>
  </form>
</details>
{{ end }}

{{ if .Groups }}
<div class="scroll">
<table>
  <thead><tr><th>Group</th><th class="num">Rank</th><th>Created</th>{{ if .CanRevise }}<th></th>{{ end }}</tr></thead>
  <tbody>
  {{ range .Groups }}
    <tr>
      <td>{{ .Name }} <span class="muted">{{ .ID }}</span></td>
      <td class="num">{{ .Rank }}</td>
      <td>{{ if not .CreatedAt.IsZero }}{{ .CreatedAt.Format "2006-01-02" }}{{ end }}</td>
      {{ if $.CanRevise }}
      <td>
        <details{{ if .Refused }} open{{ end }}>
          <summary>Revise</summary>
          <form method="post" action="{{ $.Path }}/{{ .ID }}?page={{ $.Page }}">
            <input type="hidden" name="read_name" value="{{ .Name }}">
            <input type="hidden" name="read_rank" value="{{ .Rank }}">
            <input name="name" value="{{ .FormName }}" aria-label="name" required>
            <input name="rank" value="{{ .FormRank }}" aria-label="rank" inputmode="numeric">
            <button type="submit">Write</button>
          </form>
        </details>
      </td>
      {{ end }}
    </tr>
  {{ end }}
  </tbody>
</table>
</div>
{{ else }}
<p class="muted">No customer group has been written.</p>
{{ end }}

<nav>
  {{ if .HasPrev }}<a href="{{ .Path }}?page={{ .PrevPage }}">Previous</a>{{ end }}
  <span class="muted">Page {{ .Page }}</span>
  {{ if .HasNext }}<a href="{{ .Path }}?page={{ .NextPage }}">Next</a>{{ end }}
</nav>
{{ end }}
