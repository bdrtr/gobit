{{- /*
orders.gohtml is the order list.

The rows come from the cross-module read layer, not from a module's service: the
panel knows no module (ADR 0011). Every field is printed as an ordinary value,
so the template engine's escaping applies to all of them — an order's e-mail is
customer-supplied text and the panel runs inside an administrator's session.

Paging shows "next" only when the read returned one record more than the page
holds. There is no total and no last page: a count over a growing order table is
the expensive half of paging (3.03 ms against 0.47 ms for the page itself, on a
52,000-row fixture) and an operator does not need to be told how many orders
exist in total.
*/ -}}
{{ define "body" }}
<h1>{{ .Title }}</h1>

{{/* The orders awaiting their payment (ADR 0294), and an operator's (ADR 0298). */}}
<form method="get" action="{{ .Path }}">
  <label><input type="checkbox" name="awaiting" value="1"{{ if .Awaiting }} checked{{ end }}> Only the orders awaiting their payment</label>
  <label><input type="checkbox" name="placed" value="1"{{ if .Placed }} checked{{ end }}> Only the orders an operator placed</label>
  {{ with .Customer }}<input type="hidden" name="customer" value="{{ . }}">{{ end }}
  {{/* The orders in one status (ADR 0361). */}}
  <select name="status" aria-label="status">
    <option value="">every status</option>
    {{ range .Statuses }}<option value="{{ . }}"{{ if eq . $.Status }} selected{{ end }}>{{ . }}</option>{{ end }}
  </select>
  {{/* The orders placed in one sales channel, the one their cart was opened
  in (ADR 0410); offered by name when the channels could be read. */}}
  {{ if .Channels }}
  <select name="channel" aria-label="sales channel">
    <option value="">every sales channel</option>
    {{ range .Channels }}<option value="{{ .ID }}"{{ if eq .ID $.Channel }} selected{{ end }}>{{ .Name }}</option>{{ end }}
  </select>
  {{ else }}{{ with .Channel }}<input type="hidden" name="channel" value="{{ . }}">{{ end }}{{ end }}
  <button type="submit">Show</button>
</form>
{{/* One customer's orders, which their page links to (ADR 0358). */}}
{{ with .Customer }}<p class="muted">The orders of customer {{ . }}. <a href="{{ $.Path }}">Every order</a></p>{{ end }}

{{ if .Orders }}
{{/* Each order's placed margin, the order module's (ADR 0401, ADR 0412); a
failed read leaves the list standing and says so once. */}}
{{ if .MarginsUnread }}<p class="muted">The orders' margins could not be read.</p>{{ end }}
<div class="scroll">
<table>
  <thead>
    <tr>
      <th>Order</th><th>Status</th><th>Customer</th>
      <th class="num">Total</th>{{ if .MarginsShown }}<th class="num">Placed margin</th>{{ end }}<th>Placed</th>
    </tr>
  </thead>
  <tbody>
  {{ range .Orders }}
    <tr>
      <td><a href="{{ $.Path }}/{{ .ID }}">#{{ .DisplayID }}</a></td>
      <td><span class="pill">{{ .Status }}</span></td>
      <td>{{ if .Email }}{{ .Email }}{{ else }}<span class="muted">no address</span>{{ end }}</td>
      {{- /*
      An amount whose currency scale could not be read is shown as minor units
      and SAID to be, rather than being divided by a guessed hundred: that would
      print the wrong figure for every 0-digit and 3-digit currency.
      */ -}}
      <td class="num">
        {{ .Total }} {{ .Currency }}{{ if .Minor }} <span class="muted">(minor)</span>{{ end }}
      </td>
      {{ if $.MarginsShown }}<td class="num">{{ if not $.MarginsUnread }}{{ with index $.Margins .ID }}{{ if .Known }}{{ .Margin }}{{ else }}<span class="muted" title="{{ .Note }}">—</span>{{ end }}{{ end }}{{ end }}</td>{{ end }}
      <td>{{ if not .PlacedAt.IsZero }}{{ .PlacedAt.Format "2006-01-02 15:04" }}{{ end }}</td>
    </tr>
  {{ end }}
  </tbody>
</table>
</div>
{{ else }}
<p class="muted">No orders on this page.</p>
{{ end }}

<nav>
  {{ if .HasPrev }}<a href="{{ .Path }}?page={{ .PrevPage }}{{ if .Awaiting }}&amp;awaiting=1{{ end }}{{ if .Placed }}&amp;placed=1{{ end }}{{ with .Customer }}&amp;customer={{ . }}{{ end }}{{ with .Status }}&amp;status={{ . }}{{ end }}{{ with .Channel }}&amp;channel={{ . }}{{ end }}">Previous</a>{{ end }}
  <span class="muted">Page {{ .Page }}</span>
  {{ if .HasNext }}<a href="{{ .Path }}?page={{ .NextPage }}{{ if .Awaiting }}&amp;awaiting=1{{ end }}{{ if .Placed }}&amp;placed=1{{ end }}{{ with .Customer }}&amp;customer={{ . }}{{ end }}{{ with .Status }}&amp;status={{ . }}{{ end }}{{ with .Channel }}&amp;channel={{ . }}{{ end }}">Next</a>{{ end }}
</nav>
{{ end }}
