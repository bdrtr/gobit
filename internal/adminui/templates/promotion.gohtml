{{- /*
promotion.gohtml is one promotion's page (ADR 0313).

Everything on it comes from the promotion module's panel surface: what the
promotion gives, the rules a cart must meet, the campaign it belongs to and
its latest uses, newest first. A promotion with no discount applies nothing,
and the page says so rather than leaving the section out.

An operator who may write promotions removes a rule here, and limits a
discount that lands on items to categories (ADR 0315): one target rule that
matches an item filed under any of the chosen categories or under one of
their descendants. The categories are offered, and named in the rules, only
to an operator who may read the catalog.
*/ -}}
{{ define "body" }}
<p><a href="{{ .Path }}?status={{ .Promotion.Status }}">Promotions</a></p>
<h1>{{ .Title }}</h1>

{{ with .Refused }}<p role="alert">{{ . }}</p>{{ end }}

<table>
  <tbody>
    <tr><th>Status</th><td>{{ .Promotion.Status }}</td></tr>
    <tr><th>Type</th><td>{{ .Promotion.Type }}</td></tr>
    <tr><th>Used</th><td>{{ .Promotion.UsageCount }}{{ with .Promotion.UsageLimit }} of {{ . }}{{ end }}</td></tr>
    {{ if not .Promotion.CreatedAt.IsZero }}<tr><th>Created</th><td>{{ .Promotion.CreatedAt.Format "2006-01-02" }}</td></tr>{{ end }}
  </tbody>
</table>

<h2>Discount</h2>
{{ with .Promotion.Method }}
<table>
  <tbody>
    <tr><th>Gives</th><td>{{ $.Gives }}</td></tr>
    <tr><th>On</th><td>{{ $.Target }}{{ if eq .Allocation "across" }}, spread across them{{ else }}, on each{{ end }}</td></tr>
    {{ with .MaxQuantity }}<tr><th>At most</th><td>{{ . }} units of a line</td></tr>{{ end }}
    {{ with .BuyQuantity }}<tr><th>Buy</th><td>{{ . }} units</td></tr>{{ end }}
    {{ with .ApplyToQuantity }}<tr><th>Rewarded</th><td>the {{ . }} cheapest units</td></tr>{{ end }}
  </tbody>
</table>
{{ if $.Written }}<p role="status">The discount was written.</p>{{ end }}
{{ with $.DiscountForm }}
{{/* How much the discount gives, changed from the type and the value the
page was drawn with (ADR 0338): a percentage typed as a percent, a fixed
amount in its currency's decimals. */}}
<details{{ if .Refused }} open{{ end }}>
  <summary>Change how much it gives</summary>
  <form method="post" action="{{ $.Path }}/{{ $.Promotion.ID }}/discount">
    <input type="hidden" name="read_type" value="{{ .ReadType }}">
    <input type="hidden" name="read_value" value="{{ .ReadValue }}">
    <input type="hidden" name="currency" value="{{ .Currency }}">
    <input name="value" value="{{ .Value }}" aria-label="discount" inputmode="decimal" required>
    {{ if eq .ReadType "percentage" }}%{{ else }}{{ .Currency }}{{ end }}
    <button type="submit">Write</button>
  </form>
</details>
{{ end }}
{{ else }}
<p class="muted">No discount is defined; the promotion applies nothing.</p>
{{ end }}

<h2>Rules</h2>
{{ if .Rules }}
<p class="muted">The promotion applies only where every rule holds.</p>
<div class="scroll">
<table>
  <thead><tr><th>Kind</th><th>Attribute</th><th>Operator</th><th>Values</th>{{ if .CanEditRules }}<th></th>{{ end }}</tr></thead>
  <tbody>
  {{ range .Rules }}
    <tr><td>{{ .Type }}</td><td>{{ .Attribute }}</td><td>{{ .Operator }}</td><td>{{ .Values }}</td>
      {{ if $.CanEditRules }}<td>
        <form method="post" action="{{ $.Path }}/{{ $.Promotion.ID }}/rules/{{ .ID }}/remove">
          <button type="submit">Remove</button>
        </form>
      </td>{{ end }}
    </tr>
  {{ end }}
  </tbody>
</table>
</div>
{{ else }}
<p class="muted">No rule is set.</p>
{{ end }}

{{ with .Categories }}
<form method="post" action="{{ $.Path }}/{{ $.Promotion.ID }}/rules">
  <p>Only on items in these categories, or in a category under them:</p>
  {{ if .Unavailable }}
  <p class="muted">The categories could not be read.</p>
  {{ else }}
  <select name="category" multiple aria-label="categories" size="6">
    {{ range .Options }}<option value="{{ .ID }}">{{ .Name }}</option>{{ end }}
  </select>
  <button type="submit">Limit the discount</button>
  {{ end }}
</form>
{{ end }}

{{ with .Groups }}
<form method="post" action="{{ $.Path }}/{{ $.Promotion.ID }}/rules/customer-groups">
  <p>Only for customers in one of these groups:</p>
  {{ if .Unavailable }}
  <p class="muted">The customer groups could not be read.</p>
  {{ else if .Options }}
  <select name="customer_group" multiple aria-label="customer groups" size="6">
    {{ range .Options }}<option value="{{ .ID }}">{{ .Name }}</option>{{ end }}
  </select>
  <button type="submit">Limit the promotion</button>
  {{ if .Truncated }}<p class="muted">Only the newest {{ .Offered }} groups are offered.</p>{{ end }}
  {{ else }}
  <p class="muted">No customer group exists.</p>
  {{ end }}
</form>
{{ end }}

<h2>Campaign</h2>
{{ with .Promotion.Campaign }}
<table>
  <tbody>
    <tr><th>Name</th><td>{{ .Name }}</td></tr>
    <tr><th>From</th><td>{{ with .StartsAt }}{{ .Format "2006-01-02 15:04" }}{{ else }}<span class="muted">always</span>{{ end }}</td></tr>
    <tr><th>Until</th><td>{{ with .EndsAt }}{{ .Format "2006-01-02 15:04" }}{{ else }}<span class="muted">open</span>{{ end }}</td></tr>
    <tr><th>Budget</th><td>{{ with $.Budget }}{{ . }}{{ else }}<span class="muted">none</span>{{ end }}</td></tr>
  </tbody>
</table>
{{ else }}{{ with .Promotion.CampaignID }}
<p role="alert">The promotion's campaign {{ . }} was deleted, so the promotion applies nothing until it is put into another campaign or out of any.</p>
{{ else }}
<p class="muted">The promotion belongs to no campaign.</p>
{{ end }}{{ end }}
{{ if .CanPlace }}
{{ if .CampaignsUnread }}
<p class="muted">The campaigns could not be read, so none is offered.</p>
{{ else }}
<form method="post" action="{{ $.Path }}/{{ $.Promotion.ID }}/campaign">
  <input type="hidden" name="from" value="{{ .CurrentCampaign }}">
  <select name="campaign_id" aria-label="campaign">
    <option value="">no campaign</option>
    {{ range .CampaignChoices }}<option value="{{ .ID }}"{{ if eq .ID $.CurrentCampaign }} selected{{ end }}>{{ .Name }} ({{ .CampaignIdentifier }})</option>
    {{ end }}
  </select>
  <button type="submit">Set the campaign</button>
</form>
{{ if .CampaignsMore }}<p class="muted">Only the first {{ .CampaignChoiceCount }} campaigns are offered.</p>{{ end }}
{{ end }}
{{ end }}

<h2>Latest uses</h2>
{{ if .Uses }}
<div class="scroll">
<table>
  <thead><tr><th>Reference</th><th class="num">Discount</th><th>Used</th><th>Given back</th></tr></thead>
  <tbody>
  {{ range .Uses }}
    <tr>
      <td>{{ .Reference }}</td>
      <td class="num">{{ .Amount }}</td>
      <td>{{ .CreatedAt.Format "2006-01-02 15:04" }}</td>
      <td>{{ with .ReleasedAt }}{{ .Format "2006-01-02 15:04" }}{{ end }}</td>
    </tr>
  {{ end }}
  </tbody>
</table>
</div>
{{ else }}
<p class="muted">Not used yet.</p>
{{ end }}
{{ end }}
