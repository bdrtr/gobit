{{- /*
taxes.gohtml is the tax module's tax regions (ADR 0355).

A tax region is a country, or a province under one, with the rates it
charges: a rate with a rule is charged only on the items its rule matches,
and the default rate, which has none, on the rest. A region with no provider
of its own inherits its country's, and a country with none computes its tax
in the module. A rate's name and rate are corrected here (ADR 0378), and a
country's rate is tried on past orders (ADR 0395); the admin API writes
everything else.
*/ -}}
{{ define "body" }}
<h1>{{ .Title }}</h1>

{{ with .Refused }}<p role="alert">{{ . }}</p>{{ end }}
{{ with .Written }}<p role="status">Tax rate {{ . }} was written.</p>{{ end }}

{{ if .TaxRegions }}
<div class="scroll">
<table>
  <thead>
    <tr><th>Country</th><th>Province</th><th>Rates</th><th>Provider</th></tr>
  </thead>
  <tbody>
  {{ range $row := .TaxRegions }}
    <tr>
      <td>{{ .Country }}<br><span class="muted">{{ .ID }}</span></td>
      <td>{{ with .Province }}{{ . }}{{ else }}<span class="muted">the whole country</span>{{ end }}</td>
      <td>{{ range $i, $rate := .Rates }}{{ if $i }}<br>{{ end }}{{ $rate.Name }} {{ $rate.Percent }}%{{ with $rate.Code }} <span class="muted">{{ . }}</span>{{ end }}{{ if $rate.Default }} <span class="pill">default</span>{{ end }}
        {{- if and $.CanTry $row.Tryable }}
        {{/* A rate tried on past orders (ADR 0395): another value, or a rule
        added, which a default rate does not take. */}}
        <details>
          <summary>Try on past orders</summary>
          <form method="get" action="{{ $.Path }}/rates/{{ $rate.ID }}/trial">
            <input type="date" name="from" value="{{ $.Trial.FromDay }}" aria-label="first day" required>
            <input type="date" name="to" value="{{ $.Trial.ToDay }}" aria-label="last day" required>
            <input name="rate" value="{{ $rate.Percent }}" aria-label="rate to try, percent" inputmode="decimal">%
            {{ if $rate.Default }}<input type="hidden" name="value_only" value="1">{{ else }}
            <select name="rule_reference" aria-label="rule reference">{{ range $.References }}<option value="{{ . }}">{{ . }}</option>{{ end }}</select>
            <input name="rule_id" aria-label="rule reference id">
            {{ end }}
            <button type="submit">Try</button>
          </form>
        </details>
        {{- end }}
        {{- if $.CanRevise }}
        {{/* The name and the rate corrected from the ones the rate was drawn
        with (ADR 0378); the code and the default are not among them. */}}
        <details{{ if $rate.Refused }} open{{ end }}>
          <summary>Correct</summary>
          <form method="post" action="{{ $.Path }}/rates/{{ $rate.ID }}?page={{ $.Page }}">
            <input type="hidden" name="read_name" value="{{ $rate.Name }}">
            <input type="hidden" name="read_rate_bps" value="{{ $rate.RateBps }}">
            <input name="name" value="{{ $rate.Form.Name }}" aria-label="name" required>
            <input name="rate" value="{{ $rate.Form.Rate }}" aria-label="rate, percent" inputmode="decimal" required>%
            <button type="submit">Write</button>
          </form>
        </details>
        {{- end }}{{ else }}<span class="muted">none</span>{{ end }}</td>
      <td>{{ with .Provider }}{{ . }}{{ else }}<span class="muted">inherited</span>{{ end }}</td>
    </tr>
  {{ end }}
  </tbody>
</table>
</div>
{{ else }}
<p class="muted">No tax region here.</p>
{{ end }}

<nav>
  {{ if .HasPrev }}<a href="{{ .Path }}?page={{ .PrevPage }}">Previous</a>{{ end }}
  <span class="muted">Page {{ .Page }}</span>
  {{ if .HasNext }}<a href="{{ .Path }}?page={{ .NextPage }}">Next</a>{{ end }}
</nav>
{{ end }}
