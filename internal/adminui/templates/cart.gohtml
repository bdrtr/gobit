{{- /*
cart.gohtml is a telephone order's cart: its lines as the catalog priced them,
its totals and the form that adds a line (ADR 0290), and its address, its
shipping and the completion with an offline method (ADR 0291).

Every amount is printed with its currency, and an amount whose scale could not
be read says it is in minor units.
*/ -}}
{{ define "body" }}
<h1>Telephone order</h1>

{{ with .Refused }}<p role="alert">{{ . }}</p>{{ end }}

<div class="panel">
  <p>
    <span class="pill">{{ if .Cart.Completed }}completed{{ else }}open{{ end }}</span>
    <span class="muted">{{ .Cart.ID }}</span>
  </p>
  <p>
    {{ if .Cart.Email }}{{ .Cart.Email }}{{ else }}<span class="muted">no address on this cart</span>{{ end }}
    {{ with .Cart.CustomerID }}<span class="muted">customer {{ . }}</span>{{ end }}
  </p>
</div>

<h2>Lines</h2>

{{ if .Cart.Lines }}
<table>
  <thead>
    <tr><th>Item</th><th class="num">Quantity</th><th class="num">Unit price</th><th class="num">Total</th></tr>
  </thead>
  <tbody>
    {{ range .Cart.Lines }}
    <tr>
      <td>{{ if .AddOn }}&nbsp;&nbsp;+ {{ end }}{{ .Title }}<br><span class="muted">{{ .VariantID }}</span></td>
      <td class="num">{{ .Quantity }}</td>
      <td class="num">{{ .UnitPrice }}</td>
      <td class="num">{{ .Total }}</td>
    </tr>
    {{ end }}
  </tbody>
</table>
{{ else }}
<p class="muted">The cart holds no line yet.</p>
{{ end }}

<h2>Shipping</h2>

<table>
  <tbody>
    <tr>
      <th>Ship to</th>
      <td>{{ range .Cart.ShipTo }}{{ . }}<br>{{ else }}<span class="muted">no shipping address</span>{{ end }}</td>
    </tr>
    <tr>
      <th>Method</th>
      <td>{{ range .Cart.Methods }}{{ .Name }} <span class="num">{{ .Amount }} {{ $.Cart.Currency }}</span><br>{{ else }}<span class="muted">no shipping method</span>{{ end }}</td>
    </tr>
  </tbody>
</table>

<h2>Amounts</h2>

<table>
  <tbody>
    <tr><th>Subtotal</th><td class="num">{{ .Cart.Subtotal }} {{ .Cart.Currency }}</td></tr>
    <tr><th>Tax</th><td class="num">{{ .Cart.Tax }} {{ .Cart.Currency }}</td></tr>
    <tr><th>Shipping</th><td class="num">{{ .Cart.Shipping }} {{ .Cart.Currency }}</td></tr>
    <tr>
      <th>Total</th>
      <td class="num">
        <strong>{{ .Cart.Total }} {{ .Cart.Currency }}</strong>
        {{ if .Cart.Unscaled }}<span class="muted">(minor units)</span>{{ end }}
        {{ if .Cart.TotalsStale }}<span class="muted">(not yet priced for the latest change)</span>{{ end }}
      </td>
    </tr>
  </tbody>
</table>

{{ if and .CanWrite (not .Cart.Completed) }}
<h3>Add a line</h3>
{{ if .CanSearch }}
{{/* A product found by its title offers its variants to the form (ADR 0293). */}}
<form method="get" action="{{ .CartsPath }}/{{ .Cart.ID }}">
  <input name="find" value="{{ .Search }}" placeholder="product title" aria-label="find a product">
  <button type="submit">Find</button>
</form>
{{ if .FindFailed }}<p class="muted">The products could not be read; type the variant's id.</p>
{{ else if and .Search (not .Found) }}<p class="muted">No product's title matches "{{ .Search }}".</p>{{ end }}
{{ end }}
<form method="post" action="{{ .CartsPath }}/{{ .Cart.ID }}/lines">
  <input name="sales_channel_id" value="{{ .Typed.Get "sales_channel_id" }}" placeholder="sales channel id" aria-label="sales channel" required>
  {{ if .Found }}
  <select name="variant_id" aria-label="variant" required>
    {{ range .Found }}<option value="{{ .ID }}">{{ .Label }}</option>{{ end }}
  </select>
  {{ else }}
  <input name="variant_id" value="{{ .Typed.Get "variant_id" }}" placeholder="variant id" aria-label="variant" required>
  {{ end }}
  <input name="quantity" value="{{ with .Typed.Get "quantity" }}{{ . }}{{ else }}1{{ end }}" inputmode="numeric" aria-label="quantity" required>
  <button type="submit">Add</button>
</form>

<h3>Ship to</h3>
<form method="post" action="{{ .CartsPath }}/{{ .Cart.ID }}/address">
  {{ range $name := .AddressFields }}
  <input name="{{ $name }}" value="{{ with $.Typed.Get $name }}{{ . }}{{ else }}{{ index $.Cart.Address $name }}{{ end }}" placeholder="{{ $name }}" aria-label="{{ $name }}">
  {{ end }}
  <button type="submit">Save the address</button>
</form>

<h3>Shipping method</h3>
{{ if and .OptionsRead (not .Options) }}
<p class="muted">No shipping option serves this cart.</p>
{{ else }}
<form method="post" action="{{ .CartsPath }}/{{ .Cart.ID }}/shipping">
  {{ if .OptionsRead }}
  {{/* The options the cart can take, each priced for it (ADR 0292). */}}
  <select name="shipping_option_id" aria-label="shipping option" required>
    {{ range .Options }}<option value="{{ .ID }}"{{ if eq .ID ($.Typed.Get "shipping_option_id") }} selected{{ end }}>{{ .Name }} — {{ .Amount }}</option>{{ end }}
  </select>
  {{ else }}
  <span class="muted">The options could not be read; type the option's id.</span>
  <input name="shipping_option_id" value="{{ .Typed.Get "shipping_option_id" }}" placeholder="shipping option id" aria-label="shipping option" required>
  {{ end }}
  <button type="submit">Choose</button>
</form>
{{ end }}

{{ if .Cart.Lines }}
<h3>Complete</h3>
<form method="post" action="{{ .CartsPath }}/{{ .Cart.ID }}/complete">
  <p>Read the total to the caller first: the order is placed for {{ .Cart.Total }} {{ .Cart.Currency }} and owes it until the money arrives.</p>
  <input type="hidden" name="read_total" value="{{ .Cart.TotalMinor }}">
  <input name="sales_channel_id" value="{{ .Typed.Get "sales_channel_id" }}" placeholder="sales channel id" aria-label="sales channel" required>
  <input name="payment_provider_id" value="{{ .Typed.Get "payment_provider_id" }}" placeholder="offline method, e.g. bank_transfer" aria-label="offline method" required>
  <button type="submit">Place the order</button>
</form>
{{ end }}
{{ end }}
{{ end }}
