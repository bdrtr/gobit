{{- /*
product.gohtml shows one product with its variants, prices and stock.

The three come from three different modules and are joined by the read layer in
two calls; the screen itself performs no join and knows no module.

Three printing decisions are visible here and all are about not lying:

  - An amount marked as minor units is printed with that label. The currency's
    scale is not two for every currency, and a screen that guessed would show a
    wrong price confidently.
  - A variant with no inventory item shows an em dash, not 0. Zero means "sold
    out"; nothing tracking the variant is a different fact.
  - A related product the storefront leaves out, a draft or an archived one,
    says so beside its name (ADR 0181): the list reads as the operator wrote
    it, and a shopper sees a shorter one.
*/ -}}
{{ define "body" }}
<p><a href="{{ .ProductsPath }}">← Products</a></p>

<h1>{{ .Product.Title }}</h1>
<p><a href="{{ .EditPath }}">Edit</a></p>
<dl>
  <dt>Handle</dt><dd>{{ .Product.Handle }}</dd>
  <dt>Status</dt><dd>{{ .Product.Status }}</dd>
  {{ with .Product.PublishAtUTC }}<dt>Publishes at</dt><dd>{{ . }}</dd>{{ end }}
  {{ with .Product.ArchiveAtUTC }}<dt>Archived at</dt><dd>{{ . }}</dd>{{ end }}
  <dt>Id</dt><dd>{{ .Product.ID }}</dd>
</dl>

<h2>Variants</h2>
{{ if .Variants }}
<table>
  <thead>
    <tr><th>Title</th><th>SKU</th><th>Prices</th><th>Stock</th></tr>
  </thead>
  <tbody>
  {{ range .Variants }}
    <tr>
      <td><a href="{{ $.ProductsPath }}/{{ $.Product.ID }}/variants/{{ .ID }}">{{ .Title }}</a></td>
      <td>{{ .SKU }}</td>
      <td>
        {{ if .Prices }}
          {{ range .Prices }}
            <span>{{ .Amount }} {{ .Currency }}{{ if .Minor }} (minor units){{ end }}</span>
          {{ end }}
        {{ else }}
          <span>No price</span>
        {{ end }}
      </td>
      <td>{{ if .Stock }}{{ .Stock }}{{ else }}—{{ end }}</td>
    </tr>
  {{ end }}
  </tbody>
</table>
{{ else }}
<p>This product has no variants.</p>
{{ end }}

<h2>Related products</h2>
<p><a href="{{ .RelationsPath }}">Edit related products</a></p>
{{ range .Relations }}
<h3>{{ .Label }}</h3>
{{ if .Products }}
<ol>
  {{ range .Products }}
  <li><a href="{{ $.ProductsPath }}/{{ .ID }}">{{ .Title }}</a> ({{ .Handle }}){{ if .Hidden }} — {{ .Status }}; the storefront leaves it out{{ end }}</li>
  {{ end }}
</ol>
{{ else }}
<p>None.</p>
{{ end }}
{{ end }}
{{ end }}
