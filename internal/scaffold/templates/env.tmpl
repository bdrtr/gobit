# The settings this project needs to start. Every name here is one gobit reads;
# the full list, with the reasoning for each, is in the framework's own
# .env.example.
#
# This file is NOT committed (see .gitignore): it holds secrets.

# development | staging | production
APP_ENV=development
APP_PORT=9000

# The defaults below match docker-compose.yml. In a shared environment they are
# refused unless overridden — gobit stops at startup rather than starting with a
# development database.
DATABASE_URL='postgres://gobit:gobit@localhost:5432/gobit?sslmode=disable'
REDIS_URL='redis://:gobit@localhost:6379/0'

# The secret every admin session token is signed with. There is NO default: a
# framework that invented one would hand every installation the same key.
# Generate one with: openssl rand -base64 48
JWT_SECRET=

# The first administrator. Both are required together, and the account is
# created once, at the first startup that finds the table empty.
ADMIN_BOOTSTRAP_EMAIL=
ADMIN_BOOTSTRAP_PASSWORD=
