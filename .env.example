# Bu dosyayı `.env` olarak kopyalayın ve gerektiği gibi düzenleyin.
# Tüm değerlerin kodda makul varsayılanları vardır; .env olmadan da
# `make up && make run` çalışır.

# development | staging | production
APP_ENV=development
APP_PORT=9000

# debug | info | warn | error
LOG_LEVEL=info
# json | text  (yerel geliştirmede "text" daha okunaklıdır)
LOG_FORMAT=text

# deploy/docker-compose.yml ile uyumlu varsayılanlar.
# ÜRETİMDE MUTLAKA DEĞİŞTİRİN.
DATABASE_URL=postgres://gobit:gobit@localhost:5432/gobit?sslmode=disable
REDIS_URL=redis://localhost:6379/0

SHUTDOWN_TIMEOUT=15s
READ_HEADER_TIMEOUT=10s

# docker-compose port eşlemeleri (çakışma varsa değiştirin)
POSTGRES_PORT=5432
REDIS_PORT=6379
