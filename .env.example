# Bu dosyayı `.env` olarak kopyalayın ve gerektiği gibi düzenleyin.
# Tüm değerlerin kodda makul varsayılanları vardır; .env olmadan da
# `make up && make run` çalışır.
#
# BİÇİM: .env, POSIX kabuk semantiğiyle yüklenir (`set -a; . ./.env`).
# İçinde `$` geçen değerleri MUTLAKA tek tırnağa alın, aksi hâlde kabuk
# onları değişken olarak genişletir:
#     REDIS_URL='redis://:pa$$word@localhost:6379/0'    # doğru
#     REDIS_URL=redis://:pa$word@localhost:6379/0       # YANLIŞ -> "pa"
# `#` içeren değerler için de tek tırnak önerilir.

# development | staging | production
APP_ENV=development
APP_PORT=9000

# debug | info | warn | error
LOG_LEVEL=info
# json | text  (yerel geliştirmede "text" daha okunaklıdır)
LOG_FORMAT=text

# --- Bağlantılar ---
# Aşağıdaki varsayılanlar deploy/docker-compose.yml ile eşleşir ve YALNIZCA
# yerel geliştirme içindir. APP_ENV=production iken bu ikisi ezilmezse
# uygulama açılışta hata verip durur (bkz. internal/core/config/config.go).
DATABASE_URL='postgres://gobit:gobit@localhost:5432/gobit?sslmode=disable'
REDIS_URL='redis://:gobit@localhost:6379/0'

# Olay veri yolu arka ucu: inmemory | redis
# inmemory tek süreçlidir ve süreç ölünce olaylar kaybolur; birden çok örnek
# çalıştırılıyorsa redis kullanın.
EVENT_BUS=inmemory

# --- HTTP zaman aşımları ---
SHUTDOWN_TIMEOUT=15s
# Yalnızca başlıkların okunma süresi
READ_HEADER_TIMEOUT=10s
# Başlık + gövdenin tamamının okunma süresi (Slowloris gövde saldırısına karşı)
READ_TIMEOUT=15s
WRITE_TIMEOUT=30s
IDLE_TIMEOUT=120s

# --- docker-compose ---
# Portlar 127.0.0.1'e bağlanır; paylaşılan ağa açılmaz.
POSTGRES_PORT=5432
POSTGRES_USER=gobit
POSTGRES_PASSWORD=gobit
POSTGRES_DB=gobit
REDIS_PORT=6379
REDIS_PASSWORD=gobit
